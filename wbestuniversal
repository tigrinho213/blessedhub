--========================================================
-- AIMBOT TARGET FINDER (400M RANGE)
--========================================================

local function GetClosestTarget()
    local closest, shortestDist = nil, Config.Aimbot.FOV
    local mousePos = UserInputService:GetMouseLocation()
    local camPos = Camera.CFrame.Position

    for model, data in pairs(EntityCache) do
        if model and model.Parent and data.Humanoid and data.Humanoid.Health > 0 and data.Root then
            local distMeters = (camPos - data.Root.Position).Magnitude
            if distMeters <= Config.Globe.MaxDistance then
                local isPlayer = data.IsPlayer
                if isPlayer or (not isPlayer and Config.Aimbot.TargetNPCs) then
                    local targetPart = model:FindFirstChild(Config.Aimbot.TargetPart) or data.Head or data.Root
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            -- Wall Check logic
                            local visible = true
                            if Config.Aimbot.WallCheck then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = RaycastFilterType.Exclude
                                rayParams.FilterDescendantsInstances = {LocalPlayer.Character, model}
                                local result = Workspace:Raycast(camPos, targetPart.Position - camPos, rayParams)
                                if result then visible = false end
                            end

                            if visible then
                                local dist = (Vector2_new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closest = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

