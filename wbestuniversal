local function GetSilentAimTarget()
    -- Hit Chance logic (10,000,000% garante acertar sempre)
    if math.random(1, 100) > (Config.Combat.HitChance) then
        return nil
    end

    local closest, shortestAngle = nil, Config.Combat.SilentAimMaxAngle
    local camPos = Camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()

    for model, data in pairs(EntityCache) do
        if model and model.Parent and data.Humanoid and data.Humanoid.Health > 0 and data.Head then
            local distMeters = (camPos - data.Head.Position).Magnitude
            if distMeters <= Config.Combat.SilentAimDistance then
                local screenPos, onScreen = Camera:WorldToViewportPoint(data.Head.Position)
                if onScreen then
                    local dist = (Vector2_new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestAngle then
                        shortestAngle = dist
                        closest = data.Head
                    end
                end
            end
        end
    end
    return closest
end

