--========================================================
-- CAMERA FOV & LIGHTING OVERRIDES
--========================================================

RunService:BindToRenderStep("FixedFOV", Enum.RenderPriority.Camera.Value + 1, function()
    if Config.Globe.FixedFOVEnabled and Workspace.CurrentCamera then
        Workspace.CurrentCamera.FieldOfView = Config.Globe.FixedFOV
    end

    if Config.Globe.FullBright then
        Lighting.Ambient = Color3_fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3_fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end

    if Config.Globe.NoFog then
        Lighting.FogEnd = 9e9
    end

    if Config.Globe.CustomTime then
        Lighting.TimeOfDay = string.format("%02d:00:00", Config.Globe.TimeOfDay)
    end
end)

task.spawn(function()
    local lastTime = os.clock()
    local frameCount = 0
    while true do
        task.wait(0.5)
        local currentTime = os.clock()
        local fps = math_floor(frameCount / (currentTime - lastTime))
        FPSLabel.Text = "FPS: " .. tostring(fps)
        frameCount = 0
        lastTime = currentTime

        local ping = 0
        pcall(function()
            ping = math_floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        PingLabel.Text = "PING: " .. tostring(ping) .. "ms"
    end
end)

--========================================================
-- OPTIMIZED NOCLIP & JUMP CACHE
--========================================================

local LocalCharacterParts = {}
local function CacheCharacterParts(character)
    LocalCharacterParts = {}
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            table_insert(LocalCharacterParts, part)
        end
    end
end

if LocalPlayer.Character then CacheCharacterParts(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    CacheCharacterParts(char)
end)

RunService.Stepped:Connect(function()
    if Config.Character.Noclip then
        for i = 1, #LocalCharacterParts do
            local p = LocalCharacterParts[i]
            if p and p.Parent then
                p.CanCollide = false
            end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if Config.Character.InfiniteJump and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

--========================================================
-- UNIVERSAL ENTITY / NPC & PLAYER SCANNER
--========================================================

local EntityCache = {}
local OriginalSizes = {}

local function ClearEntityESP(model)
    if EntityCache[model] then
        for _, obj in pairs(EntityCache[model]) do
            if typeof(obj) == "Instance" then
                obj:Destroy()
            end
        end
        EntityCache[model] = nil
    end
end

local function GetEntityRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") 
        or model:FindFirstChild("Torso") 
        or model:FindFirstChild("UpperTorso") 
        or model:FindFirstChild("LowerTorso") 
        or model.PrimaryPart
end

local function IsValidEntity(model)
    if not model or not model:IsA("Model") or model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildWhichIsA("Humanoid")
    local root = GetEntityRoot(model)
    if hum and hum.Health > 0 and root then
        return true
    end
    return false
end

local function SetupEntityESP(model)
    if EntityCache[model] or not IsValidEntity(model) then return end

    local player = Players:GetPlayerFromCharacter(model)
    local isPlayer = player ~= nil

    local root = GetEntityRoot(model)
    local head = model:FindFirstChild("Head") or root
    local hum = model:FindFirstChildWhichIsA("Humanoid")

    if not root or not hum then return end

    local data = {
        Model = model,
        Root = root,
        Head = head,
        Humanoid = hum,
        IsPlayer = isPlayer,
        Name = isPlayer and player.DisplayName or model.Name
    }

    local mainColor = isPlayer and Purple or OrangeNPC
    local boxColor = isPlayer and PurpleLight or OrangeNPC

    local highlight = Instance.new("Highlight")
    highlight.Adornee = model
    highlight.FillColor = mainColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = White
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = model
    data.Highlight = highlight

    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = root
    box.Size = Vector3_new(4, 6, 2)
    box.Color3 = boxColor
    box.Transparency = 0.6
    box.AlwaysOnTop = true
    box.Visible = false
    box.Parent = root
    data.Box = box

    if head then
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2_fromOffset(220, 65)
        billboard.StudsOffset = Vector3_new(0, 3.8, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = head
        billboard.Enabled = false
        billboard.Parent = head

        local nameLabel = NewText(billboard, "", 12, White)
        nameLabel.Size = UDim2_fromOffset(220, 18)
        nameLabel.Position = UDim2_fromOffset(0, 0)
        nameLabel.Font = Enum.Font.GothamBold

        local healthBg = Instance.new("Frame")
        healthBg.Size = UDim2_fromOffset(140, 6)
        healthBg.Position = UDim2_fromOffset(40, 22)
        healthBg.BackgroundColor3 = Color3_fromRGB(40, 40, 40)
        healthBg.BorderSizePixel = 0
        healthBg.Parent = billboard
        Corner(healthBg, 3)

        local healthFill = Instance.new("Frame")
        healthFill.Size = UDim2_fromScale(1, 1)
        healthFill.BackgroundColor3 = Green
        healthFill.BorderSizePixel = 0
        healthFill.Parent = healthBg
        Corner(healthFill, 3)

        local infoLabel = NewText(billboard, "", 11, Gray)
        infoLabel.Size = UDim2_fromOffset(220, 32)
        infoLabel.Position = UDim2_fromOffset(0, 30)

        data.Billboard = billboard
        data.NameLabel = nameLabel
        data.HealthBg = healthBg
        data.HealthFill = healthFill
        data.InfoLabel = infoLabel
    end

    local line = Instance.new("LineHandleAdornment")
    line.Length = 0
    line.Thickness = 2
    line.Color3 = mainColor
    line.AlwaysOnTop = true
    line.Visible = false
    line.Adornee = root
    line.Parent = root
    data.TracerLine = line

    EntityCache[model] = data

    hum.Died:Connect(function()
        ClearEntityESP(model)
    end)
end

task.spawn(function()
    while true do
        task.wait(1)
        for model, data in pairs(EntityCache) do
            if not model or not model.Parent or not data.Humanoid or data.Humanoid.Health <= 0 then
                ClearEntityESP(model)
            end
        end

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and IsValidEntity(obj) then
                SetupEntityESP(obj)
            end
        end
    end
end)

-- RAYCAST WALL CHECK
local function IsVisible(targetPart)
    if not Config.Aimbot.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local ignoreList = {Camera}
    if LocalPlayer.Character then table_insert(ignoreList, LocalPlayer.Character) end
    raycastParams.FilterDescendantsInstances = ignoreList

    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then
        return result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

local function GetClosestTarget(maxRadius, maxDist)
    local closest, shortestDist = nil, maxRadius or Config.Aimbot.FOV
    local camPos = Camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()

    for model, data in pairs(EntityCache) do
        local isAllowed = data.IsPlayer or Config.Aimbot.TargetNPCs
        if isAllowed and model and model.Parent and data.Humanoid and data.Humanoid.Health > 0 then
            local targetPart = model:FindFirstChild(Config.Aimbot.TargetPart) or data.Head or data.Root
            if targetPart then
                local distMeters = (camPos - targetPart.Position).Magnitude
                if not maxDist or distMeters <= maxDist then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local screenDist = (Vector2_new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if screenDist < shortestDist and IsVisible(targetPart) then
                            shortestDist = screenDist
                            closest = {
                                Model = model,
                                Part = targetPart,
                                Position = targetPart.Position,
                                ScreenPosition = screenPos
                            }
                        end
                    end
                end
            end
        end
    end
    return closest
end

--========================================================
-- MAIN RENDER LOOP
--========================================================

RunService.RenderStepped:Connect(function(deltaTime)
    local camPos = Camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()

    if Config.Aimbot.ShowFOV then
        FOVCircle.Visible = true
        FOVCircle.Size = UDim2_fromOffset(Config.Aimbot.FOV * 2, Config.Aimbot.FOV * 2)
        FOVCircle.Position = UDim2_fromOffset(mousePos.X, mousePos.Y)
    else
        FOVCircle.Visible = false
    end

    if Config.ESP.Enabled then
        for model, data in pairs(EntityCache) do
            local show = (data.IsPlayer and true) or (not data.IsPlayer and Config.ESP.IncludeNPCs)
            if show and data.Humanoid and data.Humanoid.Health > 0 and data.Root then
                local distMeters = math_floor((camPos - data.Root.Position).Magnitude)
                local healthPct = math_clamp(data.Humanoid.Health / math.max(data.Humanoid.MaxHealth, 1), 0, 1)
                local healthColor = Green:Lerp(Red, 1 - healthPct)
                local finalColor = Config.ESP.ColorByHealth and healthColor or (data.IsPlayer and Purple or OrangeNPC)

                if data.Highlight then
                    data.Highlight.Enabled = Config.ESP.Chams
                    data.Highlight.FillColor = finalColor
                end

                if data.Box then
                    data.Box.Visible = Config.ESP.Box
                    data.Box.Color3 = finalColor
                end

                if data.Billboard then
                    data.Billboard.Enabled = Config.ESP.Name or Config.ESP.Distance or Config.ESP.HealthBar or Config.ESP.ShowTool
                    
                    if Config.ESP.Name then
                        data.NameLabel.Text = data.Name
                        data.NameLabel.TextColor3 = finalColor
                    else
                        data.NameLabel.Text = ""
                    end

                    if Config.ESP.HealthBar then
                        data.HealthBg.Visible = true
                        data.HealthFill.Size = UDim2_fromScale(healthPct, 1)
                        data.HealthFill.BackgroundColor3 = healthColor
                    else
                        data.HealthBg.Visible = false
                    end

                    local toolObj = model:FindFirstChildOfClass("Tool")
                    local toolName = toolObj and toolObj.Name or "None"
                    local infoText = ""

                    if Config.ESP.Distance then infoText = infoText .. "[" .. distMeters .. "m] " end
                    if Config.ESP.ShowTool then infoText = infoText .. "Item: " .. toolName end
                    data.InfoLabel.Text = infoText
                end

                if data.TracerLine then
                    data.TracerLine.Visible = Config.ESP.Tracers
                    data.TracerLine.Color3 = finalColor
                    data.TracerLine.CFrame = CFrame_new(Vector3.zero, data.Root.Position - camPos)
                    data.TracerLine.Length = (data.Root.Position - camPos).Magnitude
                end
            else
                if data.Highlight then data.Highlight.Enabled = false end
                if data.Box then data.Box.Visible = false end
                if data.Billboard then data.Billboard.Enabled = false end
                if data.TracerLine then data.TracerLine.Visible = false end
            end
        end
    else
        for _, data in pairs(EntityCache) do
            if data.Highlight then data.Highlight.Enabled = false end
            if data.Box then data.Box.Visible = false end
            if data.Billboard then data.Billboard.Enabled = false end
            if data.TracerLine then data.TracerLine.Visible = false end
        end
    end

    if Config.Aimbot.Enabled then
        local isAiming = not Config.Aimbot.HoldToAim or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if isAiming then
            local target = GetClosestTarget(Config.Aimbot.FOV)
            if target and target.Part then
                local targetPos = target.Position
                if Config.Aimbot.Prediction and target.Model:FindFirstChild("HumanoidRootPart") then
                    targetPos = targetPos + (target.Model.HumanoidRootPart.Velocity * 0.033)
                end
                
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame_new(currentCFrame.Position, targetPos)
                local smoothness = math_clamp(Config.Aimbot.Smoothness, 1, 100)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1 / smoothness)
            end
        end
    end

    for model, data in pairs(EntityCache) do
        if model and model.Parent then
            local targetPart = model:FindFirstChild(Config.Globe.HitboxTarget)
            if targetPart and targetPart:IsA("BasePart") then
                if not OriginalSizes[targetPart] then
                    OriginalSizes[targetPart] = targetPart.Size
                end

                local distMeters = (camPos - targetPart.Position).Magnitude
                if Config.Globe.HitboxEnabled and distMeters <= Config.Globe.MaxDistance then
                    targetPart.Size = Vector3_new(Config.Globe.HitboxSize, Config.Globe.HitboxSize, Config.Globe.HitboxSize)
                    targetPart.Transparency = 0.7
                    targetPart.CanCollide = false
                else
                    if OriginalSizes[targetPart] then
                        targetPart.Size = OriginalSizes[targetPart]
                        targetPart.Transparency = 0
                    end
                end
            end
        end
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")

        if hum then
            if Config.Character.SpeedEnabled then hum.WalkSpeed = Config.Character.Speed end
            if Config.Character.JumpPowerEnabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.Character.JumpPower
            end
        end

        if root and Config.Character.SpinBot then
            root.CFrame = root.CFrame * CFrame_Angles(0, math_rad(Config.Character.SpinSpeed * deltaTime * 10), 0)
        end

        if root and Config.Character.Fly then
            local flyVec = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVec = flyVec + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVec = flyVec - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVec = flyVec - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVec = flyVec + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyVec = flyVec + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then flyVec = flyVec - Vector3.new(0, 1, 0) end

            if flyVec.Magnitude > 0 then
                root.Velocity = flyVec.Unit * Config.Character.FlySpeed
            else
                root.Velocity = Vector3.zero
            end
        end
    end
end)
