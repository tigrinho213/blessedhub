--========================================================
-- BUSCA DE ALVO AIMBOT
--========================================================

local function GetClosestTarget()
    local closest, shortestDist = nil, Config.Aimbot.FOV
    local camPos = Camera.CFrame.Position
    local screenCenter = Vector2_new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for model, data in pairs(EntityCache) do
        local isAllowed = data.IsPlayer or Config.Aimbot.TargetNPCs
        if isAllowed and model and model.Parent and data.Humanoid and data.Humanoid.Health > 0 then
            local targetPart = model:FindFirstChild(Config.Aimbot.TargetPart) or data.Head or data.Root
            if targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distFromCenter = (Vector2_new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distFromCenter < shortestDist then
                        shortestDist = distFromCenter
                        closest = targetPart
                    end
                end
            end
        end
    end
    return closest
end

--========================================================
-- CONTADOR DE FPS E PING
--========================================================

task.spawn(function()
    local lastTime = os.clock()
    local frameCount = 0
    while true do
        task.wait(0.5)
        local currentTime = os.clock()
        local fps = math_floor(frameCount / (currentTime - lastTime))
        FPSLabel.Text = "FPS: " .. tostring(fps)
        frameCount = 0
        lastTime = currentTime

        local ping = 0
        pcall(function()
            ping = math_floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        PingLabel.Text = "PING: " .. tostring(ping) .. "ms"
    end
end)

--========================================================
-- LOOP PRINCIPAL DE RENDERIZAÇÃO (RENDERSTEPPED)
--========================================================

RunService.RenderStepped:Connect(function(deltaTime)
    -- Atualização do Círculo de FOV
    if Config.Aimbot.ShowFOV then
        FOVCircle.Visible = true
        FOVCircle.Size = UDim2_fromOffset(Config.Aimbot.FOV * 2, Config.Aimbot.FOV * 2)
    else
        FOVCircle.Visible = false
    end

    -- Atualização do ESP
    if Config.ESP.Enabled then
        local camPos = Camera.CFrame.Position
        for model, data in pairs(EntityCache) do
            local show = (data.IsPlayer and true) or (not data.IsPlayer and Config.ESP.IncludeNPCs)
            if show and data.Humanoid and data.Humanoid.Health > 0 and data.Root then
                local dist = math_floor((camPos - data.Root.Position).Magnitude)
                local healthPct = math_clamp(data.Humanoid.Health / math.max(data.Humanoid.MaxHealth, 1), 0, 1)
                local healthColor = Green:Lerp(Red, 1 - healthPct)
                local finalColor = Config.ESP.ColorByHealth and healthColor or (data.IsPlayer and Purple or OrangeNPC)

                if data.Highlight then
                    data.Highlight.Enabled = Config.ESP.Chams
                    data.Highlight.FillColor = finalColor
                end

                if data.Box then
                    data.Box.Visible = Config.ESP.Box
                    data.Box.Color3 = finalColor
                end

                if data.Billboard then
                    data.Billboard.Enabled = Config.ESP.Name or Config.ESP.Distance or Config.ESP.HealthBar or Config.ESP.ShowTool
                    
                    if Config.ESP.Name then
                        data.NameLabel.Text = data.Name
                        data.NameLabel.TextColor3 = finalColor
                    else
                        data.NameLabel.Text = ""
                    end

                    if Config.ESP.HealthBar then
                        data.HealthBg.Visible = true
                        data.HealthFill.Size = UDim2_fromScale(healthPct, 1)
                        data.HealthFill.BackgroundColor3 = healthColor
                    else
                        data.HealthBg.Visible = false
                    end

                    local toolObj = model:FindFirstChildOfClass("Tool")
                    local toolName = toolObj and toolObj.Name or "Nenhum"
                    local infoText = ""

                    if Config.ESP.Distance then infoText = infoText .. "[" .. dist .. "m] " end
                    if Config.ESP.ShowTool then infoText = infoText .. "Item: " .. toolName end
                    data.InfoLabel.Text = infoText
                end
            else
                if data.Highlight then data.Highlight.Enabled = false end
                if data.Box then data.Box.Visible = false end
                if data.Billboard then data.Billboard.Enabled = false end
            end
        end
    else
        for _, data in pairs(EntityCache) do
            if data.Highlight then data.Highlight.Enabled = false end
            if data.Box then data.Box.Visible = false end
            if data.Billboard then data.Billboard.Enabled = false end
        end
    end

    -- Lógica de Aimbot
    if Config.Aimbot.Enabled then
        local targetPart = GetClosestTarget()
        if targetPart then
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame_new(currentCFrame.Position, targetPart.Position)
            local smoothness = math_clamp(Config.Aimbot.Smoothness, 1, 50)
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1 / smoothness)
        end
    end

    -- Hitbox Expander
    for model, data in pairs(EntityCache) do
        if model and model.Parent then
            local targetPart = model:FindFirstChild(Config.Globe.HitboxTarget)
            if targetPart and targetPart:IsA("BasePart") then
                if not OriginalSizes[targetPart] then
                    OriginalSizes[targetPart] = targetPart.Size
                end

                local distMeters = (Camera.CFrame.Position - targetPart.Position).Magnitude
                if Config.Globe.HitboxEnabled and distMeters <= Config.Globe.MaxDistance then
                    targetPart.Size = Vector3_new(Config.Globe.HitboxSize, Config.Globe.HitboxSize, Config.Globe.HitboxSize)
                    targetPart.Transparency = 0.7
                    targetPart.CanCollide = false
                else
                    if OriginalSizes[targetPart] then
                        targetPart.Size = OriginalSizes[targetPart]
                        targetPart.Transparency = 0
                    end
                end
            end
        end
    end

    -- Modificações Globais de Iluminação e FOV
    if Config.Globe.FixedFOVEnabled then Camera.FieldOfView = Config.Globe.FixedFOV end
    if Config.Globe.FullBright then
        Lighting.Ambient = Color3_fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3_fromRGB(255, 255, 255)
    end
    if Config.Globe.NoFog then Lighting.FogEnd = 9e9 end
    if Config.Globe.CustomTime then
        Lighting.TimeOfDay = string.format("%02d:00:00", Config.Globe.TimeOfDay)
    end

    -- Modificações do Personagem (Velocidade, Pulo, Voo, Spin)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")

        if hum then
            if Config.Character.SpeedEnabled then hum.WalkSpeed = Config.Character.Speed end
            if Config.Character.JumpPowerEnabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.Character.JumpPower
            end
        end

        if root and Config.Character.SpinBot then
            root.CFrame = root.CFrame * CFrame_Angles(0, math_rad(Config.Character.SpinSpeed * deltaTime * 10), 0)
        end

        if root and Config.Character.Fly then
            local flyVec = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVec = flyVec + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVec = flyVec - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVec = flyVec - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVec = flyVec + Camera.CFrame.RightVector end
            
            if flyVec.Magnitude > 0 then
                root.Velocity = flyVec.Unit * Config.Character.FlySpeed
            else
                root.Velocity = Vector3.zero
            end
        end
    end
end)
