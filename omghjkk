local function CreateToggle(parent, text, tableRef, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Background
    btn.Text = text .. (tableRef[key] and "  [ ON ]" or "  [ OFF ]")
    btn.TextColor3 = tableRef[key] and Green or Red
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = parent
    Corner(btn, 8)

    btn.MouseButton1Click:Connect(function()
        tableRef[key] = not tableRef[key]
        btn.Text = text .. (tableRef[key] and "  [ ON ]" or "  [ OFF ]")
        btn.TextColor3 = tableRef[key] and Green or Red
    end)
end

local function CreateSlider(parent, text, tableRef, key, min, max)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 48)
    container.BackgroundColor3 = Background
    container.Parent = parent
    Corner(container, 8)

    local label = NewText(container, text .. ": " .. tostring(tableRef[key]), 11, White)
    label.Size = UDim2.new(1, -10, 0, 18)
    label.Position = UDim2_fromOffset(8, 3)
    label.TextXAlignment = Enum.TextXAlignment.Left

    local sliderBack = Instance.new("Frame")
    sliderBack.Size = UDim2.new(1, -16, 0, 12)
    sliderBack.Position = UDim2_fromOffset(8, 26)
    sliderBack.BackgroundColor3 = Panel
    sliderBack.Parent = container
    Corner(sliderBack, 6)

    local startPercent = math_clamp((tableRef[key] - min) / (max - min), 0, 1)
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new(startPercent, 0, 1, 0)
    sliderFill.BackgroundColor3 = Purple
    sliderFill.Parent = sliderBack
    Corner(sliderFill, 6)

    local isDragging = false

    local function UpdateSlider(input)
        local pos = input.Position.X
        local fillPos = sliderBack.AbsolutePosition.X
        local fillSize = sliderBack.AbsoluteSize.X
        local percent = math_clamp((pos - fillPos) / fillSize, 0, 1)
        local val = math_floor(min + (max - min) * percent)

        tableRef[key] = val
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        label.Text = text .. ": " .. tostring(val)
    end

    sliderBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            UpdateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
end

local function CreateDropdown(parent, text, tableRef, key, options)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 38)
    container.BackgroundColor3 = Background
    container.Parent = parent
    Corner(container, 8)

    local label = NewText(container, text, 11, White)
    label.Size = UDim2.new(0.5, -10, 1, 0)
    label.Position = UDim2_fromOffset(8, 0)
    label.TextXAlignment = Enum.TextXAlignment.Left

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.48, -8, 0.75, 0)
    button.Position = UDim2.new(0.5, 0, 0.125, 0)
    button.BackgroundColor3 = Panel
    button.Text = tostring(tableRef[key])
    button.TextColor3 = PurpleLight
    button.Font = Enum.Font.GothamBold
    button.TextSize = 11
    button.Parent = container
    Corner(button, 6)
    Stroke(button, Purple, 0.4, 1)

    local index = table_find(options, tableRef[key]) or 1
    button.MouseButton1Click:Connect(function()
        index = (index % #options) + 1
        tableRef[key] = options[index]
        button.Text = tostring(options[index])
    end)
end

